{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/tmp/**)",
      "Read(/private/tmp/**)",
      "Edit(/tmp/**)",
      "Edit(/private/tmp/**)",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_linear_linear__*",
      "mcp__plugin_slack_slack__*",
      "mcp__plugin_Notion_notion__*"
    ],
    "ask": [
      "Bash(git push*--force*)",
      "Bash(git commit*--amend*)",
      "Bash(git rebase:*)",
      "Bash(git reset*--hard*)"
    ],
    "defaultMode": "auto"
  },
  "model": "claude-opus-4-8",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/code/chesterbr/dotfiles/claude/sync.sh\" push",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/code/chesterbr/dotfiles/claude/sync.sh\" commit",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Sosumi.aiff"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "Notion@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "ctx@wrapbook-claude-code-marketplace": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "tui": "default",
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "autoUpdateChannel": "latest"
}
